[Unit]
Description=Image Converter Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
User=deploy
WorkingDirectory=/home/deploy/imageconverterbot
ExecStart=/home/deploy/imageconverterbot/venv/bin/python3 bot.py
Restart=always
RestartSec=5
EnvironmentFile=/home/deploy/imageconverterbot/.env

[Install]
WantedBy=multi-user.target
